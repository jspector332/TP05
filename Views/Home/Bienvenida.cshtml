<div class="index-content">
    <h1>Bienvenido, @ViewBag.UsuarioNombre</h1>
    <h2>Datos Personales</h2>
    <h3>Nombre: @ViewBag.Usuario.nombre</h3>
    <h3>Apellido: @ViewBag.Usuario.apellido</h3>
    <h3>Tipo de Usuario: @ViewBag.Usuario.tipoUsuario</h3>
    <h3>Su contraseña es: @ViewBag.Usuario.contrasenia</h3>

    <h3>Recuerde cerrar sesión al finalizar su actividad.</h3>

    <form action='@Url.Action("Logout", "Home")' method="get">
        <button type="submit">Cerrar Sesión</button>
    </form>
</div>
